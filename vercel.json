{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/webapp", "dest": "/api/webapp.js" },
    { "src": "/webapp/(.*)", "dest": "/api/webapp.js" },
    { "src": "/api/bot", "dest": "/api/bot.js" },
    { "src": "/api/api", "dest": "/api/api.js" },
    { "src": "/api/api/(.*)", "dest": "/api/api.js" }
  ]
}